{"version":3,"kind":"Article","sha256":"7fc7d413f0fc161e0d5697c557f43e07e9a09475073dee07f7a1bd8c5c124e83","slug":"index","location":"/book/src/introduction.md","dependencies":[],"frontmatter":{"title":"Rattlesnake Vibration Controller","authors":[{"nameParsed":{"literal":"Daniel Rohe","given":"Daniel","family":"Rohe"},"name":"Daniel Rohe","email":"dprohe@sandia.gov","affiliations":["Sandia National Laboratories"],"id":"contributors-introduction-generated-uid-0","corresponding":true},{"nameParsed":{"literal":"Ryan Schultz","given":"Ryan","family":"Schultz"},"name":"Ryan Schultz","email":"rschult@sandia.gov","affiliations":["Sandia National Laboratories"],"id":"contributors-introduction-generated-uid-1"},{"nameParsed":{"literal":"Norman Hunter","given":"Norman","family":"Hunter"},"name":"Norman Hunter","email":"nfhunte@sandia.gov","affiliations":["Sandia National Laboratories"],"id":"contributors-introduction-generated-uid-2"},{"nameParsed":{"literal":"Cody Langston","given":"Cody","family":"Langston"},"name":"Cody Langston","affiliations":["Sandia National Laboratories/University of Georgia"],"id":"contributors-introduction-generated-uid-3"},{"nameParsed":{"literal":"Chad Hovey","given":"Chad","family":"Hovey"},"name":"Chad Hovey","affiliations":["Sandia National Laboratories"],"id":"contributors-introduction-generated-uid-4"}],"affiliations":[{"id":"Sandia National Laboratories","name":"Sandia National Laboratories"},{"id":"Sandia National Laboratories/University of Georgia","name":"Sandia National Laboratories/University of Georgia"}],"numbering":{"heading_1":{"start":1,"enabled":true,"template":"Chapter %s","continue":false},"heading_2":{"enabled":true,"template":"Chapter %s"},"figure":{"enumerator":"1.%s","enabled":true,"continue":false},"table":{"enumerator":"1.%s","enabled":true,"continue":false},"equation":{"enumerator":"1.%s","enabled":true,"continue":false},"heading_3":{"enabled":true},"heading_4":{"enabled":true},"heading_5":{"enabled":true},"heading_6":{"enabled":true},"code":{"enumerator":"1.%s","enabled":true}},"github":"https://github.com/sandialabs/rattlesnake-vibration-controller","keywords":["mimo","vibration","modal","structural-dynamics"],"abbreviations":{"6DoF":"Six Degree-of-Freedom","API":"Application Programming Interface","APSD":"Auto-Power Spectral Density","CCLD":"Constant Current Line Drive","COLA":"Constant Overlap and Add","CPSD":"Cross-Power Spectral Density","DTF":"Digital Tracking Filter","FEM":"Finite Element Model","FFT":"Fast Fourier Transform","FRF":"Frequency Response Function","GUI":"Graphical User Interface","ICP":"Integrated Circuit Piezoelectric","IDE":"Integrated Development Environment","IEPE":"Integrated Electronics PiezoElectric","IFFT":"Inverse Fast Fourier Transform","IP":"Internet Protocol","JSON":"Javascript Object Notation","MIMO":"Multiple Input, Multiple Output","PyPI":"Python Package Index","ReST":"Representational State Transfer","RMS":"Root-Mean-Square","SDS":"Sum of Decayed Sines","SRS":"Shock Response Spectrum","SVD":"Singular Value Decomposition","TRAC":"Time Response Assurance Criterion","UI":"User Interface","VK":"Vold-Kalman (Filter)"},"source_url":"https://github.com/sandialabs/rattlesnake-vibration-controller/blob/main/documentation/book/src/introduction.md","edit_url":"https://github.com/sandialabs/rattlesnake-vibration-controller/edit/main/documentation/book/src/introduction.md","thumbnail":"/rattlesnake-vibration-controller/dev/book/jupyter//build/Rattlesnake_Logo_Ban-ef35d6fb32f145e4b1efede8ef3f3933.png","exports":[{"format":"md","filename":"introduction.md","url":"/rattlesnake-vibration-controller/dev/book/jupyter//build/introduction-cf6a4e7ac416ede1110ba7cd6b4c9391.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"admonition","kind":"warning","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Warning: Research and Development Software","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"noGCvlaJ43"}],"key":"Ih4YNUnyGS"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Rattlesnake is, at its heart, software designed to do research and development into ","key":"uCCWXrXHfi"},{"type":"abbreviation","title":"Multiple Input, Multiple Output","children":[{"type":"text","value":"MIMO","key":"RNbVYo8v1u"}],"key":"fqlFb7TLMM"},{"type":"text","value":" Vibration Control problems without dealing with the restrictions and closed-off nature of proprietary software.  Users of Rattlesnake must be aware that various portions of the software are active research topics, so they should be used with caution.","key":"vDP9hYbwi9"}],"key":"kEACD2Ce09"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"As with any capability in active research, there is the chance that the capability does not behave as expected.  Vibration test equipment can vary in cost from hundreds of dollars to millions of dollars, and test articles can range from a few dollars of stock material for a simple beam to almost priceless if they are one-of-a-kind.  Vibration control software that does not behave as expected could therefore cause damage to such equipment, which could impart catastrophic costs to the user of the software.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"GXUo1o1eor"}],"key":"SflkkmRTm1"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"strong","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"By using the Rattlesnake software, users accept this risk to their equipment and test articles.  There is no warranty expressed or implied by using this software.  If you do not accept this risk, do not use this software.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"vhFYarObSb"}],"key":"mEvT4QYEF4"}],"key":"dDcVmTF4qm"}],"class":"dropdown","key":"VH5gMeMCll"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Rattlesnake is a combined-environments, multiple input/multiple output control system for\ndynamic excitation of structures under test.  It provides capabilities to control multiple\nresponses on the part using multiple exciters using various control strategies.  Rattlesnake\nis written in the Python programming language to facilitate multiple input/multiple output\nvibration research by allowing users to prescribe custom control laws to the controller.\nRattlesnake can target multiple hardware devices, or even perform synthetic control to simulate\na test virtually.  Rattlesnake has been used to execute control problems with up to 200\nresponse channels and 24 shaker drives.  This document describes the functionality,\narchitecture, and usage of the Rattlesnake controller to perform combined environments testing.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"AFbYj7hrm2"}],"key":"xdIHZws8jE"},{"type":"heading","depth":2,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Introduction","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"E6DWcjwaZ4"}],"label":"sec:introduction","identifier":"sec:introduction","html_id":"sec-introduction","enumerator":"1","key":"omcBqPxzej"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"The field of multiple input/multiple output (","key":"PgP8oA9i4K"},{"type":"abbreviation","title":"Multiple Input, Multiple Output","children":[{"type":"text","value":"MIMO","key":"AyaXcP3vJN"}],"key":"ck3QOU6XYK"},{"type":"text","value":") vibration testing has grown substantially in the past few years.  ","key":"WbMAGaBonv"},{"type":"abbreviation","title":"Multiple Input, Multiple Output","children":[{"type":"text","value":"MIMO","key":"JALFwUtaxs"}],"key":"fL8hu7UW0q"},{"type":"text","value":" vibration testing provides the capability to match a field environment more accurately and at more locations on the test article than traditional single-axis vibration testing.  Unfortunately, many existing vibration control systems are proprietary, which makes it difficult to implement new ","key":"D5hj8MHH3j"},{"type":"abbreviation","title":"Multiple Input, Multiple Output","children":[{"type":"text","value":"MIMO","key":"gcPJ2wO70a"}],"key":"MJl8Qhsg4R"},{"type":"text","value":" techniques.","key":"ZsEoAcYoyn"}],"key":"gAqZemOZXx"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Currently, ","key":"nKYLGnLbet"},{"type":"abbreviation","title":"Multiple Input, Multiple Output","children":[{"type":"text","value":"MIMO","key":"s0Hi43mBrd"}],"key":"tQpCXCpP2k"},{"type":"text","value":" vibration practitioners must either develop a control system from scratch to implement their ideas, or alternatively convince an ","key":"b9yxNy3Muq"},{"type":"abbreviation","title":"Multiple Input, Multiple Output","children":[{"type":"text","value":"MIMO","key":"CkQFIzjhGJ"}],"key":"uehkmESIg8"},{"type":"text","value":" vibration software vendor to implement their ideas into existing devices, and neither of these approaches are conducive to the rapid and iterative nature of research.","key":"fQ4iJjfDoM"}],"key":"QkhhfDvCDV"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"The Rattlesnake framework was developed to overcome these limitations and facilitate ","key":"HdxNSyRVyM"},{"type":"abbreviation","title":"Multiple Input, Multiple Output","children":[{"type":"text","value":"MIMO","key":"Qx04PxkxHj"}],"key":"sL1Lv9P34U"},{"type":"text","value":" vibration research.  Rattlesnake is a ","key":"SFeOC4ES7f"},{"type":"abbreviation","title":"Multiple Input, Multiple Output","children":[{"type":"text","value":"MIMO","key":"HwJtmzarzK"}],"key":"wFJLWRt59g"},{"type":"text","value":" control system that provides the user the ability to overcome testing challenges by providing a flexible framework that can be extended and modified to meet testing demands.  Rattlesnake can run multiple environments simultaneously, providing a combined-environments capability that does not yet exist in commercial software packages.  It can target multiple hardware devices, or even perform control virtually using a state space model, finite element model (","key":"gNebjbHU4J"},{"type":"abbreviation","title":"Finite Element Model","children":[{"type":"text","value":"FEM","key":"hbEGkydQgQ"}],"key":"SzyqCcVoII"},{"type":"text","value":") results, or a ","key":"aEEKhAez9f"},{"type":"link","url":"https://github.com/sandialabs/sdynpy","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"SDynPy","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"mxugSe4nF7"}],"urlSource":"https://github.com/sandialabs/sdynpy","error":true,"key":"RKwVcwv6em"},{"type":"text","value":" System.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"QehdoOmxfb"}],"key":"Dzh43lsA90"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/rattlesnake-vibration-controller/dev/book/jupyter//build/Rattlesnake_Logo_Ban-ef35d6fb32f145e4b1efede8ef3f3933.png","alt":"Rattlesnake Logo","align":"center","data":{"altTextIsAutoGenerated":true},"key":"bx9tbCrtKz","urlSource":"figures/Rattlesnake_Logo_Banner.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig:rattlesnake_logo","identifier":"fig:rattlesn